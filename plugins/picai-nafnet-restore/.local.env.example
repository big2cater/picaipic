# Copy this file to .local.env for local development overrides.
# .local.env is intentionally excluded from plugin packages.

# Optional: external Python executable for local testing.
# PICAIPIC_NAFNET_PYTHON=C:\path\to\venv\Scripts\python.exe

# Optional: external NAFNet source checkout.
# It should contain experiments\pretrained_models\*.pth.
# NAFNET_SOURCE_DIR=C:\path\to\NAFNet
