# Copy this file to .local.env for local development overrides.
# .local.env is intentionally excluded from plugin packages.

# Optional: external Python executable for local testing.
# PICAIPIC_SALUT_PYTHON=C:\path\to\venv\Scripts\python.exe

# Optional: external SA-LUT backend/source directory.
# SALUT_SOURCE_DIR=C:\path\to\salut-backend

# Optional: external model directory or explicit model files.
# SALUT_MODEL_DIR=C:\path\to\models\salut
# SALUT_CKPT_PATH=C:\path\to\models\salut\epoch=100-step=4127466.ckpt.state.pt
# SALUT_VGG_PATH=C:\path\to\models\salut\vgg_normalised.pth
