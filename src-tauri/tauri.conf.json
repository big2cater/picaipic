{
  "productName": "PicAiPic",
  "version": "1.1.0",
  "identifier": "com.big2cater.picaipic",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../src-vite build",
    "beforeDevCommand": "pnpm --dir ../src-vite dev",
    "devUrl": "http://localhost:3580",
    "frontendDist": "../src-vite/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$PICTURES/**",
          "$VIDEOS/**",
          "$DOCUMENT/**",
          "$DESKTOP/**",
          "$DOWNLOAD/**",
          "$APPCACHE/**",
          "/media/**",
          "/mnt/**",
          "/run/media/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Graphics and Design",
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/models/*": "models",
      "resources/ffmpeg/*": "ffmpeg",
      "resources/branding/*": "branding"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/big2cater/picaipic/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFNDhEMkU0QzJBMTAxNEMKUldSTUFhSEM1TkpJWHRyclJJZzhIc3VLbHUxUlo3a1F0RjdWaDh0RjBnQnJGWWZpQlpML2hJcmoK"
    }
  }
}
